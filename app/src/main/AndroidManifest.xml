<?xml version="1.0" encoding="utf-8"?>
<!--
  AndroidManifest defines application‑wide metadata such as the package name,
  activities, permissions and other components.  This manifest contains the
  minimum configuration required to launch a Jetpack Compose app.  Additional
  components (such as broadcast receivers or services) can be declared here
  when needed.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.pasteleria1000sabores">

    <application
        android:name="androidx.multidex.MultiDexApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Pastelería 1000 Sabores"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pasteleria1000Sabores">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>